{
  "name": "court-manager",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.5",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:coverage": "vitest run --config vitest.coverage.config.ts",
    "test:phase3": "vitest run --config vitest.phase3.config.ts",
    "test:phase3:integration": "vitest run --config vitest.integration.config.ts phase3",
    "test:phase3:e2e": "playwright test commercial memberships packages phase3 makeup fixed-court reservation-entitlement customer-commercial",
    "test:phase3:all": "corepack pnpm test:phase3 && corepack pnpm test:phase3:integration && corepack pnpm test:phase3:e2e",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "build": "corepack pnpm --filter @court-manager/api build && corepack pnpm --filter @court-manager/web build",
    "bootstrap:owner": "corepack pnpm --filter @court-manager/api bootstrap:owner",
    "seed:dev": "corepack pnpm --filter @court-manager/api seed:dev",
    "migrate:phase1": "corepack pnpm --filter @court-manager/api migrate:phase1",
    "migrate:phase2": "corepack pnpm --filter @court-manager/api migrate:phase2",
    "migrate:phase3": "corepack pnpm --filter @court-manager/api migrate:phase3",
    "reconcile:commercial": "corepack pnpm --filter @court-manager/api reconcile:commercial",
    "reset:dev": "node scripts/reset-dev.mjs",
    "migrate:class-discovery": "corepack pnpm --filter @court-manager/api migrate:class-discovery"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@types/node": "^22.10.5",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "@vitest/coverage-v8": "^2.1.8",
    "eslint": "^9.17.0",
    "eslint-import-resolver-typescript": "^3.7.0",
    "eslint-plugin-import": "^2.31.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
